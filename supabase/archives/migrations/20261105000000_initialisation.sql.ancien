-- =====================================================================
-- Gestiga — migration initiale (identifiants en français, sans accents)
-- Convention de priorité : plus le nombre est PETIT, plus la priorité est haute.
-- Les dates « métier » utilisent current_date (UTC côté serveur).
-- =====================================================================

-- ---------- Types ----------------------------------------------------
create type role_app       as enum ('gestionnaire', 'conducteur', 'passager');
create type type_passager  as enum ('titulaire', 'invite');
create type statut_demande as enum ('acceptee', 'liste_attente', 'annulee');
create type statut_jour    as enum ('ouvert', 'annule');   -- « complet » = 0 place disponible, calculé

-- ---------- Tables ---------------------------------------------------
create table parametres (
  id                 boolean primary key default true check (id),   -- ligne unique
  places_par_defaut  int  not null default 4 check (places_par_defaut >= 0),
  fuseau_rappels     text not null default 'UTC'
);
insert into parametres default values;

create table destinations (
  id         uuid primary key default gen_random_uuid(),
  nom        text not null unique,
  priorite   int  not null default 100,
  est_active boolean not null default true
);

create table profils (
  id                    uuid primary key references auth.users(id) on delete cascade,
  nom_complet           text not null,
  type_passager         type_passager not null default 'invite',
  priorite              int  not null default 100,
  destination_defaut_id uuid references destinations(id) on delete set null,
  est_actif             boolean not null default true,
  cree_le               timestamptz not null default now()
);

create table roles_utilisateurs (
  utilisateur_id uuid not null references profils(id) on delete cascade,
  role           role_app not null,
  primary key (utilisateur_id, role)
);

create table jours_feries (
  date_ferie date primary key,
  libelle    text
);

create table jours_service (
  date_service date primary key,
  places_total int not null check (places_total >= 0),
  statut       statut_jour not null default 'ouvert',
  conducteur_id uuid references profils(id) on delete set null
);

create table demandes (
  id              uuid primary key default gen_random_uuid(),
  utilisateur_id  uuid not null references profils(id) on delete cascade,
  date_service    date not null references jours_service(date_service) on delete cascade,
  destination_id  uuid references destinations(id) on delete set null,
  statut          statut_demande not null default 'liste_attente',
  est_automatique boolean not null default false,
  demandee_le     timestamptz not null default now(),
  unique (utilisateur_id, date_service)
);
create index on demandes (date_service, statut);

-- Compteurs lisibles par tous (alimentés par attribuer_places), diffusés en temps réel
create table stats_jour (
  date_service date primary key references jours_service(date_service) on delete cascade,
  acceptees    int not null default 0,
  en_attente   int not null default 0
);

create table remarques_conduite (
  id            uuid primary key default gen_random_uuid(),
  auteur_id     uuid not null references profils(id) on delete cascade,
  conducteur_id uuid not null references profils(id) on delete cascade,
  date_service  date not null,
  note          smallint check (note between 1 and 5),
  commentaire   text,
  cree_le       timestamptz not null default now()
);

-- File des mouvements à notifier au gestionnaire (consommée par notifier-gestionnaire).
-- id_transaction permet de regrouper les événements issus d'une même action.
create table evenements_gestionnaire (
  id              bigint generated always as identity primary key,
  type_evenement  text not null,   -- nouvelle_demande | annulation | acceptee | liste_attente
  demande_id      uuid,
  utilisateur_id  uuid,
  date_service    date,
  donnees         jsonb not null default '{}',
  id_transaction  bigint not null default txid_current(),
  cree_le         timestamptz not null default now(),
  traite_le       timestamptz
);
create index on evenements_gestionnaire (traite_le) where traite_le is null;

create table abonnements_push (
  id             uuid primary key default gen_random_uuid(),
  utilisateur_id uuid not null references profils(id) on delete cascade,
  point_acces    text not null unique,
  cles           jsonb not null,
  cree_le        timestamptz not null default now()
);

-- ---------- Fonctions utilitaires ------------------------------------
create function a_le_role(p_utilisateur uuid, p_role role_app) returns boolean
language sql stable security definer set search_path = public as $$
  select exists (
    select 1 from roles_utilisateurs
     where utilisateur_id = p_utilisateur and role = p_role);
$$;

create function est_jour_ouvre(p_date date) returns boolean
language sql stable set search_path = public as $$
  select extract(isodow from p_date) between 1 and 5
     and not exists (select 1 from jours_feries where date_ferie = p_date);
$$;

create function prochain_jour_ouvre(p_depuis date default current_date) returns date
language plpgsql stable set search_path = public as $$
declare v_date date := p_depuis + 1;
begin
  while not est_jour_ouvre(v_date) loop v_date := v_date + 1; end loop;
  return v_date;
end $$;

create function assurer_jour_service(p_date date) returns void
language sql security definer set search_path = public as $$
  insert into jours_service (date_service, places_total)
  select p_date, places_par_defaut from parametres
  on conflict (date_service) do nothing;
$$;

-- ---------- Attribution des places -----------------------------------
-- 1) les titulaires non annulés sont acceptés d'office
-- 2) les invités sont classés (priorité passager, priorité destination, heure de demande)
--    et acceptés jusqu'à saturation des places restantes ; les autres vont en liste d'attente
create function attribuer_places(p_date date) returns void
language plpgsql security definer set search_path = public as $$
declare
  v_places   int;
  v_statut   statut_jour;
  v_titulaires int;
  v_libres   int;
begin
  perform pg_advisory_xact_lock(hashtext('gestiga_attribuer_' || p_date::text));

  select places_total, statut into v_places, v_statut
    from jours_service where date_service = p_date;
  if not found then return; end if;

  if v_statut = 'annule' then
    update demandes set statut = 'liste_attente'
     where date_service = p_date and statut = 'acceptee';
  else
    update demandes d set statut = 'acceptee'
      from profils p
     where d.date_service = p_date and d.utilisateur_id = p.id
       and p.type_passager = 'titulaire' and d.statut = 'liste_attente';

    select count(*) into v_titulaires
      from demandes d join profils p on p.id = d.utilisateur_id
     where d.date_service = p_date and d.statut = 'acceptee'
       and p.type_passager = 'titulaire';

    v_libres := greatest(v_places - v_titulaires, 0);

    with invites as (
      select d.id,
             row_number() over (
               order by p.priorite, coalesce(dest.priorite, 1000), d.demandee_le
             ) as rang
        from demandes d
        join profils p on p.id = d.utilisateur_id
        left join destinations dest on dest.id = d.destination_id
       where d.date_service = p_date
         and d.statut <> 'annulee'
         and p.type_passager is distinct from 'titulaire'
    )
    update demandes d
       set statut = (case when invites.rang <= v_libres then 'acceptee' else 'liste_attente' end)::statut_demande
      from invites
     where d.id = invites.id
       and d.statut <> (case when invites.rang <= v_libres then 'acceptee' else 'liste_attente' end)::statut_demande;
  end if;

  insert into stats_jour (date_service, acceptees, en_attente)
  select p_date,
         count(*) filter (where statut = 'acceptee'),
         count(*) filter (where statut = 'liste_attente')
    from demandes where date_service = p_date
  on conflict (date_service) do update
    set acceptees = excluded.acceptees, en_attente = excluded.en_attente;
end $$;

-- ---------- Déclencheurs ---------------------------------------------
-- Journalise les mouvements pour le gestionnaire puis réattribue les places
-- (au niveau 1 seulement : les mises à jour faites par attribuer_places
-- ne relancent pas l'attribution).
create function a_la_modification_demande() returns trigger
language plpgsql security definer set search_path = public as $$
declare v_type text;
begin
  if tg_op = 'INSERT' then
    if not new.est_automatique then
      v_type := case when new.statut = 'annulee' then 'annulation' else 'nouvelle_demande' end;
    end if;
  elsif new.statut is distinct from old.statut then
    v_type := case new.statut
                when 'annulee'  then 'annulation'
                when 'acceptee' then 'acceptee'
                else 'liste_attente'
              end;
  end if;

  if v_type is not null then
    insert into evenements_gestionnaire
      (type_evenement, demande_id, utilisateur_id, date_service, donnees)
    select v_type, new.id, new.utilisateur_id, new.date_service,
           jsonb_build_object(
             'passager',    p.nom_complet,
             'type',        p.type_passager,
             'destination', dest.nom,
             'statut',      new.statut)
      from profils p
      left join destinations dest on dest.id = new.destination_id
     where p.id = new.utilisateur_id;
  end if;

  if pg_trigger_depth() = 1 then
    perform attribuer_places(new.date_service);
  end if;
  return null;
end $$;

create trigger declencheur_modification_demande
  after insert or update on demandes
  for each row execute function a_la_modification_demande();

-- Changement du nombre de places ou du statut du jour => réattribution
create function a_la_modification_jour_service() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  if pg_trigger_depth() = 1 then
    perform attribuer_places(new.date_service);
  end if;
  return null;
end $$;

create trigger declencheur_modification_jour_service
  after update of places_total, statut on jours_service
  for each row execute function a_la_modification_jour_service();

-- Création automatique du profil à l'inscription (invité + rôle passager par défaut ;
-- le gestionnaire promeut ensuite titulaires / conducteurs / gestionnaires)
create function a_la_creation_utilisateur() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  insert into profils (id, nom_complet)
  values (new.id, coalesce(new.raw_user_meta_data->>'nom_complet', new.email));
  insert into roles_utilisateurs (utilisateur_id, role) values (new.id, 'passager');
  return new;
end $$;

create trigger a_la_creation_utilisateur
  after insert on auth.users
  for each row execute function a_la_creation_utilisateur();

-- ---------- API appelée par le front (RPC) ---------------------------
create function demander_trajet(p_date date, p_destination uuid default null)
returns statut_demande
language plpgsql security definer set search_path = public as $$
declare
  v_utilisateur uuid := auth.uid();
  v_destination uuid;
  v_statut      statut_demande;
begin
  if v_utilisateur is null then raise exception 'non authentifié'; end if;
  if not exists (select 1 from profils where id = v_utilisateur and est_actif) then
    raise exception 'compte inactif';
  end if;
  if not est_jour_ouvre(p_date) or p_date < current_date then
    raise exception 'date invalide (jour ouvré à venir requis)';
  end if;

  perform assurer_jour_service(p_date);
  v_destination := coalesce(p_destination,
                     (select destination_defaut_id from profils where id = v_utilisateur));

  insert into demandes (utilisateur_id, date_service, destination_id, statut)
  values (v_utilisateur, p_date, v_destination, 'liste_attente')
  on conflict (utilisateur_id, date_service) do update
    set destination_id = coalesce(p_destination, demandes.destination_id),
        statut = case when demandes.statut = 'annulee'
                      then 'liste_attente'::statut_demande else demandes.statut end,
        demandee_le = case when demandes.statut = 'annulee'
                           then now() else demandes.demandee_le end;

  select d.statut into v_statut
    from demandes d where d.utilisateur_id = v_utilisateur and d.date_service = p_date;
  return v_statut;
end $$;

create function annuler_trajet(p_date date) returns void
language plpgsql security definer set search_path = public as $$
begin
  if auth.uid() is null then raise exception 'non authentifié'; end if;
  if p_date < current_date then raise exception 'date passée'; end if;
  update demandes set statut = 'annulee'
   where utilisateur_id = auth.uid() and date_service = p_date and statut <> 'annulee';
end $$;

-- Génération quotidienne des demandes automatiques des titulaires (appelée par pg_cron)
create function generer_demandes_quotidiennes(p_date date default null) returns int
language plpgsql security definer set search_path = public as $$
declare
  v_date date := coalesce(p_date, prochain_jour_ouvre());
  v_nb   int;
begin
  perform assurer_jour_service(v_date);

  insert into demandes (utilisateur_id, date_service, destination_id, statut, est_automatique)
  select p.id, v_date, p.destination_defaut_id, 'acceptee', true
    from profils p
   where p.type_passager = 'titulaire' and p.est_actif
  on conflict (utilisateur_id, date_service) do nothing;   -- respecte une annulation déjà faite
  get diagnostics v_nb = row_count;

  perform attribuer_places(v_date);
  return v_nb;
end $$;

-- Liste des conducteurs (pour le formulaire de remarques et la planification)
create function lister_conducteurs()
returns table (id uuid, nom_complet text)
language sql stable security definer set search_path = public as $$
  select p.id, p.nom_complet
    from profils p
    join roles_utilisateurs r on r.utilisateur_id = p.id and r.role = 'conducteur'
   where p.est_actif
   order by p.nom_complet;
$$;

-- Liste du jour pour le conducteur (pas d'accès direct aux tables)
create function manifeste_conducteur(p_date date)
returns table (nom_complet text, destination text, type_passager type_passager)
language plpgsql stable security definer set search_path = public as $$
begin
  if not (a_le_role(auth.uid(), 'conducteur') or a_le_role(auth.uid(), 'gestionnaire')) then
    raise exception 'accès refusé';
  end if;
  return query
    select p.nom_complet, dest.nom, p.type_passager
      from demandes d
      join profils p on p.id = d.utilisateur_id
      left join destinations dest on dest.id = d.destination_id
     where d.date_service = p_date and d.statut = 'acceptee'
     order by coalesce(dest.priorite, 1000), p.priorite, p.nom_complet;
end $$;

-- Synthèse des remarques (gestionnaire uniquement)
create function synthese_remarques(p_du date, p_au date)
returns table (conducteur_id uuid, conducteur_nom text, nombre_remarques bigint, note_moyenne numeric)
language plpgsql stable security definer set search_path = public as $$
begin
  if not a_le_role(auth.uid(), 'gestionnaire') then
    raise exception 'accès refusé';
  end if;
  return query
    select r.conducteur_id, p.nom_complet, count(*), round(avg(r.note), 2)
      from remarques_conduite r
      join profils p on p.id = r.conducteur_id
     where r.date_service between p_du and p_au
     group by r.conducteur_id, p.nom_complet
     order by p.nom_complet;
end $$;

-- ---------- Droits d'exécution ---------------------------------------
revoke all on function attribuer_places(date), generer_demandes_quotidiennes(date),
                       assurer_jour_service(date), a_la_modification_demande(),
                       a_la_modification_jour_service(), a_la_creation_utilisateur()
  from public, anon, authenticated;

revoke all on function demander_trajet(date, uuid), annuler_trajet(date),
                       manifeste_conducteur(date), synthese_remarques(date, date),
                       lister_conducteurs()
  from public, anon;
grant execute on function demander_trajet(date, uuid), annuler_trajet(date),
                          manifeste_conducteur(date), synthese_remarques(date, date),
                          lister_conducteurs(),
                          a_le_role(uuid, role_app), est_jour_ouvre(date),
                          prochain_jour_ouvre(date)
  to authenticated;

-- ---------- Sécurité au niveau des lignes (RLS) ----------------------
alter table parametres              enable row level security;
alter table destinations            enable row level security;
alter table profils                 enable row level security;
alter table roles_utilisateurs      enable row level security;
alter table jours_feries            enable row level security;
alter table jours_service           enable row level security;
alter table demandes                enable row level security;
alter table stats_jour              enable row level security;
alter table remarques_conduite      enable row level security;
alter table evenements_gestionnaire enable row level security;
alter table abonnements_push        enable row level security;

-- Lecture : tout utilisateur connecté
create policy destinations_lecture  on destinations  for select to authenticated using (true);
create policy jours_feries_lecture  on jours_feries  for select to authenticated using (true);
create policy jours_service_lecture on jours_service for select to authenticated using (true);
create policy stats_jour_lecture    on stats_jour    for select to authenticated using (true);
create policy parametres_lecture    on parametres    for select to authenticated using (true);

-- Écriture : gestionnaire
create policy destinations_ecriture on destinations for all to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire')) with check (a_le_role(auth.uid(), 'gestionnaire'));
create policy jours_feries_ecriture on jours_feries for all to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire')) with check (a_le_role(auth.uid(), 'gestionnaire'));
create policy jours_service_ecriture on jours_service for all to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire')) with check (a_le_role(auth.uid(), 'gestionnaire'));
create policy parametres_ecriture on parametres for all to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire')) with check (a_le_role(auth.uid(), 'gestionnaire'));

-- Profils et rôles : chacun lit le sien, le gestionnaire gère tout
create policy profils_lecture_perso on profils for select to authenticated using (id = auth.uid());
create policy profils_gestion       on profils for all    to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire')) with check (a_le_role(auth.uid(), 'gestionnaire'));
create policy roles_lecture_perso   on roles_utilisateurs for select to authenticated
  using (utilisateur_id = auth.uid());
create policy roles_gestion         on roles_utilisateurs for all to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire')) with check (a_le_role(auth.uid(), 'gestionnaire'));

-- Demandes : lecture de la sienne (ou de toutes pour le gestionnaire).
-- Aucune écriture directe : passer par demander_trajet / annuler_trajet.
create policy demandes_lecture on demandes for select to authenticated
  using (utilisateur_id = auth.uid() or a_le_role(auth.uid(), 'gestionnaire'));

-- Remarques : le conducteur n'a AUCUNE policy => aucun accès
create policy remarques_insertion on remarques_conduite for insert to authenticated
  with check (auteur_id = auth.uid() and a_le_role(conducteur_id, 'conducteur'));
create policy remarques_lecture_perso on remarques_conduite for select to authenticated
  using (auteur_id = auth.uid());
create policy remarques_lecture_gestionnaire on remarques_conduite for select to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire'));

-- Événements : gestionnaire en lecture (l'Edge Function utilise la clé de service)
create policy evenements_lecture on evenements_gestionnaire for select to authenticated
  using (a_le_role(auth.uid(), 'gestionnaire'));

-- Abonnements push : chacun gère les siens
create policy abonnements_perso on abonnements_push for all to authenticated
  using (utilisateur_id = auth.uid()) with check (utilisateur_id = auth.uid());

-- ---------- Temps réel -----------------------------------------------
alter publication supabase_realtime add table stats_jour, jours_service, demandes;
